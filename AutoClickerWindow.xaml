<Window x:Class="BackgroundClicker.Wpf.AutoClickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:BackgroundClicker.Wpf.I18n"
        Title="Auto Clicker"
        Height="662" Width="660" MinWidth="560" MinHeight="470"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource SurfaceBaseBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius}"
            TextElement.FontFamily="{StaticResource FontUI}"
            TextElement.FontSize="{StaticResource FontSizeBody}"
            TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource SurfacePanelBrush}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Rectangle Width="3" Height="20" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{i18n:T autoclicker.title}" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="{i18n:T autoclicker.subtitle}"
                                   FontSize="{StaticResource FontSizeMicro}"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Style="{StaticResource TitleBarCloseButton}" Height="44"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        ToolTip="{i18n:T nav.close}" Click="CloseButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel Margin="18,16,18,16">

                    <TextBlock Text="{i18n:T autoclicker.section.timing}" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{i18n:T autoclicker.field.interval}"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,5"
                                               HorizontalAlignment="Left"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="IntervalMsTextBox" Text="100"
                                                 Style="{StaticResource NumericTextBox}" Width="90"/>
                                        <TextBlock Text="{i18n:T autoclicker.unit.milliseconds}"
                                                   Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{i18n:T autoclicker.field.button}"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,5"
                                               HorizontalAlignment="Left"/>
                                    <ComboBox x:Name="ButtonTypeComboBox" SelectedIndex="0"
                                              Style="{StaticResource AppComboBox}">
                                        <ComboBoxItem Content="{i18n:T autoclicker.button.left}"/>
                                        <ComboBoxItem Content="{i18n:T autoclicker.button.right}"/>
                                        <ComboBoxItem Content="{i18n:T autoclicker.button.middle}"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{i18n:T autoclicker.field.clickType}"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,5"
                                               HorizontalAlignment="Left"/>
                                    <ComboBox x:Name="ClickTypeComboBox" SelectedIndex="0"
                                              Style="{StaticResource AppComboBox}">
                                        <ComboBoxItem Content="{i18n:T autoclicker.button.single}"/>
                                        <ComboBoxItem Content="{i18n:T autoclicker.button.double}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{i18n:T autoclicker.hint.cps}"
                                       Style="{StaticResource HintText}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{i18n:T autoclicker.section.target}" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <RadioButton x:Name="UseCurrentCursorRadio"
                                         Content="{i18n:T autoclicker.toggle.useCursor}"
                                         IsChecked="True" GroupName="TargetMode" Margin="0,0,0,12"
                                         Checked="UseCurrentCursorRadio_Checked"/>
                            <RadioButton x:Name="UseFixedPositionRadio"
                                         Content="{i18n:T autoclicker.toggle.useFixed}"
                                         GroupName="TargetMode" Margin="0,0,0,10"
                                         Checked="UseFixedPositionRadio_Checked"/>

                            <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                                <TextBlock Text="{i18n:T autoclicker.field.x}" Style="{StaticResource FieldLabel}"
                                           FontFamily="{StaticResource FontMono}" Margin="0,0,6,0"/>
                                <TextBox x:Name="FixedXTextBox" Style="{StaticResource NumericTextBox}"
                                         Width="76" Height="28" IsEnabled="False"/>
                                <TextBlock Text="{i18n:T autoclicker.field.y}" Style="{StaticResource FieldLabel}"
                                           FontFamily="{StaticResource FontMono}" Margin="14,0,6,0"/>
                                <TextBox x:Name="FixedYTextBox" Style="{StaticResource NumericTextBox}"
                                         Width="76" Height="28" IsEnabled="False"/>
                                <Button x:Name="PickCurrentPositionButton"
                                        Content="{i18n:T autoclicker.button.pickCurrent}"
                                        Style="{StaticResource SecondaryButton}" Height="28" Margin="14,0,0,0"
                                        Click="PickCurrentPositionButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{i18n:T autoclicker.section.behavior}" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="RandomizeIntervalCheckBox"
                                      Content="{i18n:T autoclicker.toggle.randomize}"
                                      Style="{StaticResource ToggleSwitch}"/>
                            <CheckBox x:Name="ShowClickCountCheckBox"
                                      Content="{i18n:T autoclicker.toggle.showCounter}"
                                      IsChecked="True" Style="{StaticResource ToggleSwitch}"
                                      Checked="ShowClickCountCheckBox_Changed"
                                      Unchecked="ShowClickCountCheckBox_Changed"/>
                            <CheckBox x:Name="UseHotkeyCheckBox"
                                      Content="{i18n:T autoclicker.toggle.globalHotkey}"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="UseHotkeyCheckBox_Checked"
                                      Unchecked="UseHotkeyCheckBox_Unchecked"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{i18n:T autoclicker.field.hotkey}"
                                           Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                <TextBox x:Name="ToggleHotkeyTextBox" Grid.Column="1" Text="F9"
                                         Style="{StaticResource NumericTextBox}" Width="76" Height="28"
                                         TextChanged="ToggleHotkeyTextBox_TextChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="StartStopButton" Grid.Column="0"
                                    Content="{i18n:T autoclicker.button.start}"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="150" Height="46" FontSize="14"
                                    Click="StartStopButton_Click"/>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ClickCounterTextBlock"
                                           FontFamily="{StaticResource FontMono}" FontWeight="Bold"
                                           FontSize="{StaticResource FontSizeMedium}" Margin="0,0,0,3"/>
                                <TextBlock Text="{i18n:T autoclicker.hint.keys}" Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SurfacePanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,2,2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Rectangle x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0"
                               Fill="{StaticResource StateIdleBrush}"/>
                    <TextBlock x:Name="StatusTextBlock" Text="{i18n:T autoclicker.status.idle}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
