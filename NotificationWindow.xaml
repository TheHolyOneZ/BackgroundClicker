<Window x:Class="BackgroundClicker.Wpf.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        Title="Notification"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder"
            Background="{StaticResource SurfacePanelBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius}"
            MaxWidth="460"
            TextElement.FontFamily="{StaticResource FontUI}"
            TextElement.FontSize="{StaticResource FontSizeBody}"
            TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Rectangle x:Name="AccentBar" Grid.Column="0" Fill="{StaticResource AccentBrush}"/>

            <StackPanel Grid.Column="1" Margin="20,18,20,16">
                <TextBlock x:Name="MessageTextBlock"
                           Text="Placeholder message"
                           FontSize="{StaticResource FontSizeMedium}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,0,0,18"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="88" Height="32" Margin="0,0,8,0"
                            Click="SecondaryButton_Click"/>
                    <Button x:Name="PrimaryButton"
                            Content="OK"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="110" Height="32"
                            Click="PrimaryButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
