<Window x:Class="BackgroundClicker.Wpf.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:BackgroundClicker.Wpf.I18n"
        Title="Prompt" Height="196" Width="430"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Loaded="Window_Loaded">

    <Border Background="{StaticResource SurfacePanelBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius}"
            TextElement.FontFamily="{StaticResource FontUI}"
            TextElement.FontSize="{StaticResource FontSizeBody}"
            TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource SurfaceRaisedBrush}" Height="38"
                  MouseLeftButtonDown="TitleBar_Drag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Rectangle Width="3" Height="12" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TitleTextBlock" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="20,18,20,0">
                <TextBlock x:Name="LabelTextBlock" Style="{StaticResource FieldLabel}"
                           HorizontalAlignment="Left" Margin="0,0,0,6"/>
                <TextBox x:Name="ValueTextBox" Height="32"
                         KeyDown="ValueTextBox_KeyDown"
                         TextChanged="ValueTextBox_TextChanged"/>
                <TextBlock x:Name="ErrorTextBlock"
                           Style="{StaticResource HintText}"
                           Foreground="{StaticResource StateErrorBrush}"
                           Margin="0,6,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBaseBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{i18n:T notify.cancel}" Style="{StaticResource SecondaryButton}"
                            MinWidth="88" Height="32" Margin="0,0,8,0" IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}"
                            MinWidth="88" Height="32" IsDefault="True"
                            Click="ConfirmButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
