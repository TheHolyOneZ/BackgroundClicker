<Window x:Class="BackgroundClicker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:BackgroundClicker.Wpf.I18n"
        Title="Background Clicker" Height="812" Width="1060" MinWidth="900" MinHeight="580"
        Icon="assets/icon.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip">

    <Border Background="{StaticResource SurfaceBaseBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius}"
            TextElement.FontFamily="{StaticResource FontUI}"
            TextElement.FontSize="{StaticResource FontSizeBody}"
            TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource SurfacePanelBrush}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Rectangle Width="3" Height="14" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="{i18n:T app.title}" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{i18n:T nav.help}" Style="{StaticResource NavButton}" Click="HelpButton_Click"/>
                    <Button Content="{i18n:T nav.autoclicker}" Style="{StaticResource NavButton}" Click="AutoClickerButton_Click"/>
                    <Button Content="{i18n:T nav.credits}" Style="{StaticResource NavButton}" Click="CreditsButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <ComboBox x:Name="LanguageComboBox"
                              Style="{StaticResource AppComboBox}"
                              Width="116" Height="26" VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="{i18n:T nav.language}"
                              SelectionChanged="LanguageComboBox_SelectionChanged"/>
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="{i18n:T nav.minimize}" Click="MinimizeButton_Click"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                            Style="{StaticResource TitleBarCloseButton}"
                            ToolTip="{i18n:T nav.close}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18,16,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel>

                        <TextBlock Text="{i18n:T main.section.target}" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton x:Name="SinglePointModeRadio" GroupName="ClickMode"
                                                 Content="{i18n:T main.mode.single}" IsChecked="True"
                                                 Checked="TargetMode_Changed"/>
                                    <RadioButton x:Name="SequenceModeRadio" GroupName="ClickMode"
                                                 Content="{i18n:T main.mode.sequence}"
                                                 Checked="TargetMode_Changed"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{i18n:T main.field.profile}" Style="{StaticResource FieldLabel}"/>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ProfileComboBox" Grid.Column="0"
                                                  IsEditable="False" Margin="0,0,8,0"
                                                  Style="{StaticResource AppComboBox}"
                                                  SelectionChanged="ProfileComboBox_SelectionChanged"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="NewProfileButton" Content="{i18n:T main.button.newProfile}"
                                                    Style="{StaticResource SecondaryButton}" MinWidth="58" Height="30"
                                                    Margin="0,0,6,0" Click="NewProfileButton_Click"/>
                                            <Button x:Name="SaveProfileButton" Content="{i18n:T main.button.save}"
                                                    Style="{StaticResource SecondaryButton}" MinWidth="62" Height="30"
                                                    Margin="0,0,6,0" Click="SaveProfileButton_Click"/>
                                            <Button x:Name="ProfileMenuButton" Content="&#xE712;"
                                                    FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Style="{StaticResource SecondaryButton}" Width="32" Height="30"
                                                    Padding="0" ToolTip="{i18n:T main.button.moreActions}"
                                                    Click="ProfileMenuButton_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu x:Name="ProfileMenu" Placement="Bottom">
                                                        <MenuItem Header="{i18n:T main.menu.duplicate}" Click="DuplicateProfile_Click"/>
                                                        <MenuItem Header="{i18n:T main.menu.rename}" Click="RenameProfile_Click"/>
                                                        <Separator/>
                                                        <MenuItem Header="{i18n:T main.menu.delete}"
                                                                  Style="{StaticResource DangerMenuItem}"
                                                                  Click="DeleteProfileButton_Click"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{i18n:T main.field.window}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="WindowTitleTextBox" Grid.Column="1"/>
                                </Grid>

                                <Grid x:Name="CoordinatesRow" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{i18n:T main.field.coordinates}" Style="{StaticResource FieldLabel}"/>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="X" Style="{StaticResource FieldLabel}"
                                                       FontFamily="{StaticResource FontMono}" Margin="0,0,8,0"/>
                                            <TextBox x:Name="XCoordTextBox" Grid.Column="1" Style="{StaticResource NumericTextBox}"/>
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Y" Style="{StaticResource FieldLabel}"
                                                       FontFamily="{StaticResource FontMono}" Margin="0,0,8,0"/>
                                            <TextBox x:Name="YCoordTextBox" Grid.Column="1" Style="{StaticResource NumericTextBox}"/>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <Separator/>

                                <Button x:Name="ListWindowsButton" Content="{i18n:T main.button.listWindows}"
                                        Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,0,8"
                                        Click="ListWindowsButton_Click"/>
                                <Button x:Name="AutoSetupButton" Content="{i18n:T main.button.setup}"
                                        Style="{StaticResource SecondaryButton}" Height="38"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        Foreground="{StaticResource AccentBrush}"
                                        FontWeight="SemiBold"
                                        Click="AutoSetupButton_Click"/>
                                <TextBlock x:Name="SetupHintText" Text="{i18n:T main.hint.setup}"
                                           Style="{StaticResource HintText}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="SequenceSection">
                            <TextBlock Text="{i18n:T main.section.sequence}" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border Style="{StaticResource InsetPanel}" Margin="0,0,0,10">
                                        <ListBox x:Name="SequenceListBox" Height="112"
                                                 Style="{StaticResource AppListBox}"
                                                 MouseDoubleClick="SequenceListBox_MouseDoubleClick"/>
                                    </Border>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{i18n:T main.field.stepDelay}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="SequenceDelayTextBox" Grid.Column="1" Text="1.0"
                                                 Style="{StaticResource NumericTextBox}" Width="60" Height="28"/>
                                        <TextBlock Grid.Column="2" Text="{i18n:T main.unit.seconds}"
                                                   Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="CapturePointButton" Content="{i18n:T main.button.capturePoint}"
                                                Style="{StaticResource SecondaryButton}" Height="28" Margin="0,0,6,0"
                                                BorderBrush="{StaticResource AccentBrush}"
                                                Foreground="{StaticResource AccentBrush}"
                                                Click="CapturePointButton_Click"/>
                                        <Button x:Name="RemoveSequenceStepButton" Content="{i18n:T main.button.removeStep}"
                                                Style="{StaticResource SecondaryButton}" Height="28" Margin="0,0,6,0"
                                                Click="RemoveSequenceStepButton_Click"/>
                                        <Button x:Name="ClearSequenceButton" Content="{i18n:T main.button.clearSteps}"
                                                Style="{StaticResource GhostButton}" Height="28"
                                                Click="ClearSequenceButton_Click"/>
                                    </StackPanel>

                                    <Separator Margin="0,12"/>

                                    <CheckBox x:Name="RecordStepsCheckBox"
                                              Content="{i18n:T main.toggle.recordSteps}"
                                              Style="{StaticResource ToggleSwitch}" Margin="0,0,0,6"/>

                                    <TextBlock Text="{i18n:T main.hint.sequence}" Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>

                            <TextBlock Text="{i18n:T main.section.timing}" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{i18n:T main.field.interval}" Style="{StaticResource FieldLabel}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="IntervalTextBox" Text="1.0"
                                                     Style="{StaticResource NumericTextBox}" Width="76"/>
                                            <TextBlock Text="{i18n:T main.unit.seconds}" Style="{StaticResource FieldLabel}" Margin="6,0,14,0"/>
                                            <Button Content="0.1" Tag="0.1" Style="{StaticResource PresetButton}" Height="30" Margin="0,0,6,0" Click="IntervalPreset_Click"/>
                                            <Button Content="0.5" Tag="0.5" Style="{StaticResource PresetButton}" Height="30" Margin="0,0,6,0" Click="IntervalPreset_Click"/>
                                            <Button Content="1.0" Tag="1.0" Style="{StaticResource PresetButton}" Height="30" Click="IntervalPreset_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{i18n:T main.field.stopAfterClicks}" Style="{StaticResource FieldLabel}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="StopAfterClicksTextBox" Style="{StaticResource NumericTextBox}" Width="76" Height="28"/>
                                            <TextBlock Text="{i18n:T main.unit.clicks}" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{i18n:T main.field.stopAfterMinutes}" Style="{StaticResource FieldLabel}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="StopAfterMinutesTextBox" Style="{StaticResource NumericTextBox}" Width="76" Height="28"/>
                                            <TextBlock Text="{i18n:T main.unit.minutes}" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="RandomizeIntervalCheckBox" Content="{i18n:T main.toggle.randomize}"
                                              Style="{StaticResource ToggleSwitch}"/>
                                    <CheckBox x:Name="HardStopCheckBox" Content="{i18n:T main.toggle.hardStop}"
                                              Style="{StaticResource ToggleSwitch}" Margin="0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{i18n:T main.section.behavior}" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{i18n:T main.field.jitter}" Style="{StaticResource FieldLabel}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="JitterPixelsTextBox" Text="0"
                                                     Style="{StaticResource NumericTextBox}" Width="76" Height="28"/>
                                            <TextBlock Text="{i18n:T main.unit.pixels}" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="DoubleClickCheckBox" Content="{i18n:T main.toggle.doubleClick}"
                                              Style="{StaticResource ToggleSwitch}"/>
                                    <CheckBox x:Name="AlwaysOnTopCheckBox" Content="{i18n:T main.toggle.alwaysOnTop}"
                                              Style="{StaticResource ToggleSwitch}"
                                              Checked="AlwaysOnTopCheckBox_CheckedChanged"
                                              Unchecked="AlwaysOnTopCheckBox_CheckedChanged"/>
                                    <CheckBox x:Name="BlockingClickCheckBox" Content="{i18n:T main.toggle.blocking}"
                                              Style="{StaticResource ToggleSwitch}" Margin="0"
                                              ToolTip="{i18n:T main.toggle.blockingTip}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{i18n:T main.section.sound}" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="PlayClickSoundCheckBox" Content="{i18n:T main.toggle.pingOnClick}"
                                              Style="{StaticResource ToggleSwitch}"/>
                                    <CheckBox x:Name="PlayErrorSoundCheckBox" Content="{i18n:T main.toggle.alertOnError}"
                                              Style="{StaticResource ToggleSwitch}" Margin="0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16,14">
                        <StackPanel>
                            <CheckBox x:Name="EnableAutoRepeatCheckBox" Content="{i18n:T main.toggle.autoRepeat}"
                                      Style="{StaticResource ToggleSwitchStrong}" Margin="0,0,0,12"/>
                            <Button x:Name="ExecutionButton" Content="{i18n:T main.button.start}"
                                    Style="{StaticResource PrimaryButton}" Height="46" FontSize="14"
                                    Click="ExecutionButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SurfacePanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,2,2">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="VersionTextBlock" Grid.Column="0" Text="v1.0.0"
                               FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0"
                                   Fill="{StaticResource StateIdleBrush}"/>
                        <TextBlock x:Name="StatusTextBlock" Text="{i18n:T status.idle}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextDimBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ClickCountTextBlock" Text="0"
                                   FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSmall}"
                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{i18n:T main.footer.clicksSent}" FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        <Button x:Name="ResetButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                Style="{StaticResource GhostButton}" Width="26" Height="24" Padding="0" Margin="8,0,0,0"
                                ToolTip="{i18n:T main.button.reset}" Click="ResetButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
