<Window x:Class="BackgroundClicker.Wpf.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:BackgroundClicker.Wpf.I18n"
        Title="Guide" Height="660" Width="860"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="Rule" Grid.Column="0" Fill="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1" Margin="14,9" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="Rule" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="Rule" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Marker" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="ModeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBaseBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius}"
            TextElement.FontFamily="{StaticResource FontUI}"
            TextElement.FontSize="{StaticResource FontSizeBody}"
            TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource SurfacePanelBrush}" MouseLeftButtonDown="TitleBar_Drag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Rectangle Width="3" Height="12" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="{i18n:T help.windowTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Style="{StaticResource TitleBarCloseButton}" Height="40"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        ToolTip="{i18n:T nav.close}" Click="CloseButton_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfacePanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="{i18n:T help.nav.heading}" Style="{StaticResource SectionHeader}" Margin="16,0,0,10"/>
                        <Button Content="{i18n:T help.nav.quickStart}" Tag="QuickStartSection"
                                Style="{StaticResource RailButton}" Click="RailButton_Click"/>
                        <Button Content="{i18n:T help.nav.profiles}" Tag="ProfilesSection"
                                Style="{StaticResource RailButton}" Click="RailButton_Click"/>
                        <Button Content="{i18n:T help.nav.modes}" Tag="ModesSection"
                                Style="{StaticResource RailButton}" Click="RailButton_Click"/>
                        <Button Content="{i18n:T help.nav.features}" Tag="FeaturesSection"
                                Style="{StaticResource RailButton}" Click="RailButton_Click"/>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="ContentScroller" Grid.Column="1"
                              VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel Margin="32,26,32,36">

                        <TextBlock Text="{i18n:T help.title}" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="{i18n:T help.intro}" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>

                        <Separator/>

                        <StackPanel x:Name="QuickStartSection">
                            <TextBlock Text="{i18n:T help.quickStart.heading}" Style="{StaticResource HeadingText}" Margin="0,4,0,12"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1" Style="{StaticResource Marker}"/>
                                <TextBlock Grid.Column="1" Text="{i18n:T help.quickStart.step1}" Style="{StaticResource BodyText}" Margin="0"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="2" Style="{StaticResource Marker}"/>
                                <TextBlock Grid.Column="1" Text="{i18n:T help.quickStart.step2}" Style="{StaticResource BodyText}" Margin="0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="3" Style="{StaticResource Marker}"/>
                                <TextBlock Grid.Column="1" Text="{i18n:T help.quickStart.step3}" Style="{StaticResource BodyText}" Margin="0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="ProfilesSection">
                            <TextBlock Text="{i18n:T help.profiles.heading}" Style="{StaticResource HeadingText}"/>
                            <TextBlock Text="{i18n:T help.profiles.body}" Style="{StaticResource BodyText}" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="-" Style="{StaticResource Marker}"/>
                                <TextBlock Grid.Column="1" Text="{i18n:T help.profiles.item1}" Style="{StaticResource BodyText}" Margin="0"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="-" Style="{StaticResource Marker}"/>
                                <TextBlock Grid.Column="1" Text="{i18n:T help.profiles.item2}" Style="{StaticResource BodyText}" Margin="0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="-" Style="{StaticResource Marker}"/>
                                <TextBlock Grid.Column="1" Text="{i18n:T help.profiles.item3}" Style="{StaticResource BodyText}" Margin="0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="ModesSection">
                            <TextBlock Text="{i18n:T help.modes.heading}" Style="{StaticResource HeadingText}"/>
                            <TextBlock Text="{i18n:T help.modes.nonBlockingLabel}" Style="{StaticResource ModeLabel}"/>
                            <TextBlock Text="{i18n:T help.modes.nonBlockingBody}" Style="{StaticResource BodyText}" Margin="0,0,0,16"/>
                            <TextBlock Text="{i18n:T help.modes.blockingLabel}" Style="{StaticResource ModeLabel}"/>
                            <TextBlock Text="{i18n:T help.modes.blockingBody}" Style="{StaticResource BodyText}"/>
                        </StackPanel>

                        <StackPanel x:Name="FeaturesSection">
                            <TextBlock Text="{i18n:T help.features.heading}" Style="{StaticResource HeadingText}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="-" Style="{StaticResource Marker}"/>
                                <TextBlock Grid.Column="1" Text="{i18n:T help.features.item1}" Style="{StaticResource BodyText}" Margin="0"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="-" Style="{StaticResource Marker}"/>
                                <TextBlock Grid.Column="1" Text="{i18n:T help.features.item2}" Style="{StaticResource BodyText}" Margin="0"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="-" Style="{StaticResource Marker}"/>
                                <TextBlock Grid.Column="1" Text="{i18n:T help.features.item3}" Style="{StaticResource BodyText}" Margin="0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="-" Style="{StaticResource Marker}"/>
                                <TextBlock Grid.Column="1" Text="{i18n:T help.features.item4}" Style="{StaticResource BodyText}" Margin="0"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
