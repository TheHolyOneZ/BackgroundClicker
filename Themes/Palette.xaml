<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Color x:Key="SurfaceBaseColor">#FF0A0A0B</Color>
    <Color x:Key="SurfacePanelColor">#FF121214</Color>
    <Color x:Key="SurfaceInputColor">#FF18181B</Color>
    <Color x:Key="SurfaceRaisedColor">#FF1F1F23</Color>
    <Color x:Key="SurfaceHoverColor">#FF27272B</Color>

    <Color x:Key="LineColor">#FF27272A</Color>
    <Color x:Key="LineStrongColor">#FF3F3F46</Color>

    <Color x:Key="TextPrimaryColor">#FFFAFAFA</Color>
    <Color x:Key="TextDimColor">#FFA1A1AA</Color>
    <Color x:Key="TextMutedColor">#FF71717A</Color>
    <Color x:Key="TextOnAccentColor">#FF0A0A0B</Color>

    <Color x:Key="AccentColor">#FFFFB020</Color>
    <Color x:Key="AccentHoverColor">#FFFFC048</Color>
    <Color x:Key="AccentPressedColor">#FFE09410</Color>
    <Color x:Key="AccentSubtleColor">#28FFB020</Color>

    <Color x:Key="StateRunningColor">#FF22C55E</Color>
    <Color x:Key="StateRunningHoverColor">#FF34D26E</Color>
    <Color x:Key="StateErrorColor">#FFEF4444</Color>
    <Color x:Key="StateErrorHoverColor">#FFF56565</Color>
    <Color x:Key="StateIdleColor">#FF71717A</Color>

    <SolidColorBrush x:Key="SurfaceBaseBrush"   Color="{StaticResource SurfaceBaseColor}"/>
    <SolidColorBrush x:Key="SurfacePanelBrush"  Color="{StaticResource SurfacePanelColor}"/>
    <SolidColorBrush x:Key="SurfaceInputBrush"  Color="{StaticResource SurfaceInputColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="{StaticResource SurfaceHoverColor}"/>

    <SolidColorBrush x:Key="LineBrush"          Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="LineStrongBrush"    Color="{StaticResource LineStrongColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextDimBrush"       Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="{StaticResource TextOnAccentColor}"/>

    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush"  Color="{StaticResource AccentSubtleColor}"/>

    <SolidColorBrush x:Key="StateRunningBrush"      Color="{StaticResource StateRunningColor}"/>
    <SolidColorBrush x:Key="StateRunningHoverBrush" Color="{StaticResource StateRunningHoverColor}"/>
    <SolidColorBrush x:Key="StateErrorBrush"        Color="{StaticResource StateErrorColor}"/>
    <SolidColorBrush x:Key="StateErrorHoverBrush"   Color="{StaticResource StateErrorHoverColor}"/>
    <SolidColorBrush x:Key="StateIdleBrush"         Color="{StaticResource StateIdleColor}"/>

    <CornerRadius x:Key="Radius">2</CornerRadius>
    <CornerRadius x:Key="RadiusFlat">0</CornerRadius>

    <FontFamily x:Key="FontUI">Segoe UI Variable Text, Segoe UI, Roboto, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Consolas, Cascadia Mono, Courier New, monospace</FontFamily>

    <sys:Double x:Key="FontSizeMicro">10</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">12</sys:Double>
    <sys:Double x:Key="FontSizeMedium">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeHeading">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle">24</sys:Double>

</ResourceDictionary>
