<Window x:Class="BackgroundClicker.Wpf.WatermarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:BackgroundClicker.Wpf.I18n"
        Title="Visible windows" Height="460" Width="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip">

    <Border Background="{StaticResource SurfaceBaseBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius}"
            TextElement.FontFamily="{StaticResource FontUI}"
            TextElement.FontSize="{StaticResource FontSizeBody}"
            TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource SurfacePanelBrush}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Rectangle Width="3" Height="12" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Style="{StaticResource TitleBarCloseButton}" Height="40"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        ToolTip="{i18n:T nav.close}" Click="CloseButton_Click"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource InsetPanel}" Margin="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="WatermarkTextBox"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Height="Auto"
                             VerticalContentAlignment="Top"
                             Padding="4"
                             Foreground="{StaticResource TextDimBrush}"
                             FontFamily="{StaticResource FontMono}"
                             FontSize="{StaticResource FontSizeSmall}"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
