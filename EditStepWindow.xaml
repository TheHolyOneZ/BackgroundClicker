<Window x:Class="BackgroundClicker.Wpf.EditStepWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:BackgroundClicker.Wpf.I18n"
        Title="Edit Step" Height="330" Width="470"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Loaded="Window_Loaded">

    <Border Background="{StaticResource SurfacePanelBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius}"
            TextElement.FontFamily="{StaticResource FontUI}"
            TextElement.FontSize="{StaticResource FontSizeBody}"
            TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource SurfaceRaisedBrush}" Height="38"
                  MouseLeftButtonDown="TitleBar_Drag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Rectangle Width="3" Height="12" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="{i18n:T editStep.title}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="20,16,20,0">

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{i18n:T main.field.window}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="WindowTitleTextBox" Grid.Column="1"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{i18n:T main.field.coordinates}" Style="{StaticResource FieldLabel}"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="X" Style="{StaticResource FieldLabel}"
                                       FontFamily="{StaticResource FontMono}" Margin="0,0,8,0"/>
                            <TextBox x:Name="XCoordTextBox" Grid.Column="1" Style="{StaticResource NumericTextBox}"/>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Y" Style="{StaticResource FieldLabel}"
                                       FontFamily="{StaticResource FontMono}" Margin="0,0,8,0"/>
                            <TextBox x:Name="YCoordTextBox" Grid.Column="1" Style="{StaticResource NumericTextBox}"/>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{i18n:T main.field.stepDelay}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DelayTextBox" Grid.Column="1"
                             Style="{StaticResource NumericTextBox}" Width="80"/>
                    <TextBlock Grid.Column="2" Text="{i18n:T main.unit.seconds}"
                               Style="{StaticResource FieldLabel}" Margin="8,0,0,0"/>
                </Grid>

                <CheckBox x:Name="DoubleClickCheckBox"
                          Content="{i18n:T editStep.doubleClick}"
                          Style="{StaticResource ToggleSwitch}" Margin="0,0,0,4"/>

                <TextBlock x:Name="ErrorTextBlock"
                           Style="{StaticResource HintText}"
                           Foreground="{StaticResource StateErrorBrush}"
                           Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBaseBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{i18n:T editStep.cancel}" Style="{StaticResource SecondaryButton}"
                            MinWidth="88" Height="32" Margin="0,0,8,0" IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button Content="{i18n:T editStep.save}" Style="{StaticResource PrimaryButton}"
                            MinWidth="88" Height="32" IsDefault="True" Click="SaveButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
